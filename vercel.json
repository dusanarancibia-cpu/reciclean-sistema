{
  "redirects": [
    { "source": "/conoce-diego",     "destination": "/diego-presentacion.html", "permanent": false },
    { "source": "/coordinar-equipo", "destination": "/diego-coordinar.html",    "permanent": false },
    { "source": "/preguntas",        "destination": "/diego-faq.html",          "permanent": false },
    { "source": "/ejemplos",         "destination": "/diego-ejemplos.html",     "permanent": false },
    { "source": "/dar-feedback",     "destination": "/diego-feedback.html",     "permanent": false },
    { "source": "/videos-diego",     "destination": "/diego-video-script.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    }
  ]
}
